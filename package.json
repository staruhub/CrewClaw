{
  "name": "@chaogeek/hermes",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "bin": {
    "chaogeek-hermes": "./packages/cli/bin/chaogeek-hermes.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild api/boot.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\" && cargo build --release --manifest-path crates/crewclaw-cli/Cargo.toml",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run && pnpm run test:runtime && pnpm run test:rust",
    "test:runtime": "node packages/runtime/__tests__/run-all.mjs",
    "test:rust": "cargo test --manifest-path crates/crewclaw-cli/Cargo.toml",
    "test:conformance": "node packages/runtime/conformance/runner.mjs",
    "test:e2e": "playwright test",
    "test:all": "pnpm run check && pnpm run lint && pnpm test && pnpm run test:conformance && pnpm run validate:all-experts && pnpm run build && pnpm run test:e2e",
    "crewclaw": "cargo run --quiet --manifest-path crates/crewclaw-cli/Cargo.toml --",
    "validate:expert": "node --import tsx packages/validator/src/bin.ts",
    "validate:all-experts": "node --import tsx packages/validator/src/bin.ts --all",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
