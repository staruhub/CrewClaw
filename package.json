{
  "name": "@chaogeek/hermes",
  "private": true,
  "version": "0.0.0",
  "description": "CrewClaw — digital-employee workbench: hire, run, evaluate and grow AI employees from a Rust TUI + Node runtime",
  "license": "Apache-2.0",
  "author": "ChaoGeek",
  "repository": {
    "type": "git",
    "url": "https://github.com/staruhub/CrewClaw.git"
  },
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "bin": {
    "chaogeek-hermes": "./packages/cli/bin/chaogeek-hermes.cjs",
    "crew": "./packages/cli/bin/chaogeek-hermes.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:web && cargo build --release --manifest-path crates/crewclaw-cli/Cargo.toml",
    "build:web": "vite build && node --import tsx scripts/build-employee-packages.ts && esbuild api/boot.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire as __crewCreateRequire } from 'module';const require = __crewCreateRequire(import.meta.url);\"",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "start": "node scripts/start-production.mjs",
    "check": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test": "vitest run && pnpm run test:runtime && pnpm run test:rust",
    "test:runtime": "node packages/runtime/__tests__/run-all.mjs",
    "test:runtime:live": "node packages/runtime/__tests__/run-live.mjs",
    "test:runtime:live:list": "node packages/runtime/__tests__/run-live.mjs --list",
    "test:rust": "cargo test --manifest-path crates/crewclaw-cli/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path crates/crewclaw-cli/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path crates/crewclaw-cli/Cargo.toml --all-targets --all-features -- -D warnings",
    "test:conformance": "node packages/runtime/conformance/runner.mjs",
    "test:e2e:tui": "node packages/runtime/__tests__/e2e-vterm-stream.mjs",
    "test:tui:ansi-probe": "node packages/runtime/tui/probe-ansi.mjs",
    "test:e2e:dev": "node scripts/run-playwright-e2e.mjs dev",
    "test:e2e:production": "node scripts/run-playwright-e2e.mjs production",
    "test:e2e": "pnpm run test:e2e:tui && pnpm run test:e2e:dev && pnpm run test:e2e:production",
    "test:all": "pnpm run ci:check && pnpm run test:e2e",
    "ci:check": "node scripts/ci-check.mjs",
    "crewclaw": "cargo run --quiet --manifest-path crates/crewclaw-cli/Cargo.toml --",
    "validate:expert": "node --import tsx packages/validator/src/bin.ts",
    "validate:all-experts": "node --import tsx packages/validator/src/bin.ts --all",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "schema:generate": "node --import tsx contracts/scripts/generate-schemas.ts",
    "schema:check": "node --import tsx scripts/check-generated.mjs",
    "web:employees": "node --import tsx contracts/scripts/generate-web-employees.ts",
    "memory:backfill": "node packages/runtime/memory-backfill.mjs",
    "kpi:migrate": "node packages/runtime/kpi-migrate.mjs",
    "eval:expert": "node packages/runtime/eval-runner.mjs",
    "certify:employee": "node packages/runtime/certification-runner.mjs",
    "offboard:employee": "node packages/runtime/offboarding-cli.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hookform/resolvers": "^5.5.7",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.1",
    "framer-motion": "^12.42.2",
    "hono": "^4.12.32",
    "htm": "^3.1.1",
    "iconv-lite": "^0.7.3",
    "ink": "^7.1.1",
    "input-otp": "^1.4.2",
    "jschardet": "^3.1.4",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "mysql2": "^3.23.1",
    "next-themes": "^0.4.6",
    "officeparser": "^7.4.0",
    "playwright": "1.62.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hono/vite-dev-server": "^0.19.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "ink-testing-library": "^4.0.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
