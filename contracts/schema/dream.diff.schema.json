{
  "$id": "https://crewclaw.dev/schema/dream.diff.schema.json",
  "title": "CrewClaw Dream Diff (crewclaw.dream-diff/v1)",
  "description": "Structured add/merge/replace/drop/keep entries with per-entry provenance.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "crewclaw.dream-diff/v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "merge",
              "replace",
              "drop",
              "keep"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "source_task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "item": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "user_prefs",
                  "project_facts",
                  "successful_toolchains",
                  "failure_paths",
                  "reliable_sources",
                  "verified_sops"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "superseded",
                  "archived"
                ]
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "legacy",
                  "dream"
                ]
              },
              "source_task_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "created_by_model": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dream_run_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "savedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "valid_until": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "supersedes": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sensitive": {
                "type": "boolean"
              },
              "ephemeral": {
                "type": "boolean"
              }
            },
            "required": [
              "category",
              "text",
              "confidence",
              "status",
              "source_type",
              "source_task_ids",
              "evidence_ids",
              "created_by_model",
              "dream_run_id"
            ],
            "additionalProperties": false
          },
          "replaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "op",
          "reason",
          "confidence",
          "source_task_ids",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract",
    "entries"
  ],
  "additionalProperties": false
}
