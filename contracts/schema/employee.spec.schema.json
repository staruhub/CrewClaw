{
  "$id": "https://crewclaw.dev/schema/employee.spec.schema.json",
  "title": "CrewClaw Employee Runtime Spec (crewclaw.employee.yaml)",
  "description": "Runtime layer of the two-file employee standard: how the employee works, is evaluated (eval_suite + outcome_rubric), and grows.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "english_name": {
          "type": "string",
          "minLength": 1
        },
        "avatar": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "certification": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "avatar",
        "author",
        "version",
        "certification",
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "role_contract": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_responsible_for": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "best_for": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "title",
        "mission",
        "responsibilities",
        "not_responsible_for",
        "best_for"
      ],
      "additionalProperties": false
    },
    "soul": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "working_style": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "communication_style": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "source",
        "working_style",
        "communication_style",
        "values"
      ],
      "additionalProperties": false
    },
    "deliverables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "tool_needs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "necessity": {
            "type": "string",
            "enum": [
              "required",
              "conditional",
              "non_default",
              "disabled"
            ]
          },
          "permission": {
            "type": "string",
            "enum": [
              "readonly",
              "write",
              "requires_authorization",
              "disabled"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "necessity",
          "permission",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "permission_policy": {
      "type": "object",
      "properties": {
        "default_level": {
          "type": "string",
          "minLength": 1
        },
        "levels": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "grants": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "denied": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_authorization_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "default_level",
        "levels",
        "grants",
        "denied",
        "human_authorization_required"
      ],
      "additionalProperties": false
    },
    "eval_suite": {
      "type": "object",
      "properties": {
        "smoke_tests": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "task": {
                "type": "string",
                "minLength": 1
              },
              "acceptance": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "task",
              "acceptance"
            ],
            "additionalProperties": false
          }
        },
        "grading": {
          "type": "object",
          "properties": {
            "pass_threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "required_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "pass_threshold"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "smoke_tests"
      ],
      "additionalProperties": false
    },
    "outcome_rubric": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "weight",
          "criterion"
        ],
        "additionalProperties": false
      }
    },
    "compatibility_targets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "level",
          "strategy"
        ],
        "additionalProperties": false
      }
    },
    "playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      }
    },
    "failure_playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      }
    },
    "memory_seed": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "dream_policy": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "workbench_profile": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "runtime_requirements": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "adapter_hints": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    }
  },
  "required": [
    "identity",
    "role_contract",
    "soul",
    "deliverables",
    "tool_needs",
    "permission_policy",
    "eval_suite",
    "outcome_rubric",
    "compatibility_targets"
  ],
  "additionalProperties": false
}
