{
  "$id": "https://crewclaw.dev/schema/employee.spec.schema.json",
  "title": "CrewClaw Employee Runtime Spec (crewclaw.employee.yaml)",
  "description": "Runtime layer of the two-file employee standard: how the employee works, is evaluated (eval_suite + outcome_rubric), and grows.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "english_name": {
          "type": "string",
          "minLength": 1
        },
        "avatar": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "certification": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "avatar",
        "author",
        "version",
        "certification",
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "role_contract": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_responsible_for": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "best_for": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "title",
        "mission",
        "responsibilities",
        "not_responsible_for",
        "best_for"
      ],
      "additionalProperties": false
    },
    "soul": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "working_style": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "communication_style": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "source",
        "working_style",
        "communication_style",
        "values"
      ],
      "additionalProperties": false
    },
    "deliverables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "tool_needs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "necessity": {
            "type": "string",
            "enum": [
              "required",
              "conditional",
              "non_default",
              "disabled"
            ]
          },
          "permission": {
            "type": "string",
            "enum": [
              "readonly",
              "write",
              "requires_authorization",
              "disabled"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval": {
            "type": "string",
            "enum": [
              "never",
              "when_needed",
              "always"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "object",
            "properties": {
              "max_calls_per_task": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "timeout_ms": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 300000
              }
            },
            "additionalProperties": false
          },
          "on_unavailable": {
            "type": "string",
            "enum": [
              "fail",
              "degrade",
              "ask_user",
              "skip"
            ]
          }
        },
        "required": [
          "necessity",
          "permission",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "permission_policy": {
      "type": "object",
      "properties": {
        "default_level": {
          "type": "string",
          "minLength": 1
        },
        "levels": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "grants": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "denied": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_authorization_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "default_level",
        "levels",
        "grants",
        "denied",
        "human_authorization_required"
      ],
      "additionalProperties": false
    },
    "certification_policy": {
      "type": "object",
      "properties": {
        "package_status": {
          "type": "string",
          "enum": [
            "draft",
            "validated",
            "invalid"
          ]
        },
        "lab_status": {
          "type": "string",
          "enum": [
            "untested",
            "running",
            "certified",
            "failed",
            "expired",
            "revoked",
            "stale"
          ]
        },
        "field_status": {
          "type": "string",
          "enum": [
            "insufficient",
            "pilot",
            "proven"
          ]
        },
        "profile_refs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "self_tests_are_certification": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "package_status",
        "lab_status",
        "field_status",
        "profile_refs",
        "self_tests_are_certification"
      ],
      "additionalProperties": false
    },
    "eval_suite": {
      "type": "object",
      "properties": {
        "smoke_tests": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "task": {
                "type": "string",
                "minLength": 1
              },
              "acceptance": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "task",
              "acceptance"
            ],
            "additionalProperties": false
          }
        },
        "grading": {
          "type": "object",
          "properties": {
            "pass_threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "required_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "pass_threshold"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "smoke_tests"
      ],
      "additionalProperties": false
    },
    "outcome_rubric": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "weight",
          "criterion"
        ],
        "additionalProperties": false
      }
    },
    "compatibility_targets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "level",
          "strategy"
        ],
        "additionalProperties": false
      }
    },
    "playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      }
    },
    "failure_playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      }
    },
    "memory_seed": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "dream_policy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "recommended",
            "manual",
            "disabled"
          ]
        },
        "triggers": {
          "type": "object",
          "properties": {
            "min_accepted_tasks": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "memory_pressure_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "duplicate_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "stale_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "conflict_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "repeat_task_count": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "recommendation_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "eligibility": {
          "type": "object",
          "properties": {
            "trusted_input_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "properties": {
            "memory_budget_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "max_model_cost_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "input_policy": {
          "type": "object",
          "properties": {
            "guidance": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "retention": {
              "type": "string",
              "minLength": 1
            },
            "forbid_sensitive": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "promotion_policy": {
          "type": "object",
          "properties": {
            "require_baseline": {
              "type": "boolean"
            },
            "require_candidate_eval": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "cooldown": {
          "type": "object",
          "properties": {
            "hours": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_batch_tasks": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "after_task": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retention": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "workbench_profile": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "runtime_requirements": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "adapter_hints": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    }
  },
  "required": [
    "identity",
    "role_contract",
    "soul",
    "deliverables",
    "tool_needs",
    "permission_policy",
    "eval_suite",
    "outcome_rubric",
    "compatibility_targets"
  ],
  "additionalProperties": false
}
