{
  "$id": "https://crewclaw.dev/schema/memory.activation.schema.json",
  "title": "CrewClaw Memory Activation (crewclaw.memory-activation/v1)",
  "description": "Atomic swap record: previous store hash, activated store hash, archive location.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "crewclaw.memory-activation/v1"
    },
    "activation_id": {
      "type": "string",
      "minLength": 1
    },
    "dream_run_id": {
      "type": "string",
      "minLength": 1
    },
    "employee_id": {
      "type": "string",
      "minLength": 1
    },
    "previous_memory_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "activated_memory_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "archived_to": {
      "type": "string",
      "minLength": 1
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "contract",
    "activation_id",
    "dream_run_id",
    "employee_id",
    "previous_memory_hash",
    "activated_memory_hash",
    "archived_to",
    "activated_at"
  ],
  "additionalProperties": false
}
