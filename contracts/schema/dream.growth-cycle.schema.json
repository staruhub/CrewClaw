{
  "$id": "https://crewclaw.dev/schema/dream.growth-cycle.schema.json",
  "title": "CrewClaw Dream Growth Cycle (crewclaw.growth-cycle/v1)",
  "description": "Persistent approval-gated binding from Dream recommendation to a normal TaskRun and the next learning cycle.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "crewclaw.growth-cycle/v1"
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "employee_id": {
      "type": "string",
      "minLength": 1
    },
    "dream_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "next_task",
        "dream_revision"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "RECOMMENDED",
        "REVISION_REQUIRED",
        "APPROVED",
        "QUEUED",
        "RUNNING",
        "AWAITING_DELIVERY_APPROVAL",
        "DELIVERED",
        "REJECTED",
        "EVALUATED",
        "LEARNED",
        "NEXT_RECOMMENDED",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "context": {
      "type": "object",
      "properties": {
        "task_run_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kpi": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "evaluation": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "history_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "task_run_ids",
        "evidence_ids",
        "kpi",
        "evaluation",
        "history_hash"
      ],
      "additionalProperties": false
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_run_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "revision_needed",
            "failed",
            "cancelled"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "transitions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "RECOMMENDED",
                  "REVISION_REQUIRED",
                  "APPROVED",
                  "QUEUED",
                  "RUNNING",
                  "AWAITING_DELIVERY_APPROVAL",
                  "DELIVERED",
                  "REJECTED",
                  "EVALUATED",
                  "LEARNED",
                  "NEXT_RECOMMENDED",
                  "BLOCKED",
                  "FAILED",
                  "CANCELLED"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "RECOMMENDED",
              "REVISION_REQUIRED",
              "APPROVED",
              "QUEUED",
              "RUNNING",
              "AWAITING_DELIVERY_APPROVAL",
              "DELIVERED",
              "REJECTED",
              "EVALUATED",
              "LEARNED",
              "NEXT_RECOMMENDED",
              "BLOCKED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "task_run_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "idempotency_key",
          "event",
          "from",
          "to",
          "at",
          "task_run_id",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "contract",
    "cycle_id",
    "employee_id",
    "dream_id",
    "kind",
    "state",
    "goal",
    "context",
    "plan_hash",
    "approved_by",
    "approved_at",
    "task_run_id",
    "outcome",
    "transitions",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
