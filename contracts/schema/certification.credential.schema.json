{
  "$id": "https://crewclaw.dev/schema/certification.credential.schema.json",
  "title": "CrewClaw Certification Credential",
  "description": "Signed, non-mock evidence binding an employee subject to a profile, runtime, models, and repeated run receipts.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "crewclaw.certification-credential/v1"
    },
    "credential_id": {
      "type": "string",
      "minLength": 1
    },
    "employee_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
    },
    "memory_state_hash": {
      "type": "string",
      "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "certified",
        "failed",
        "expired",
        "revoked",
        "stale"
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "hash"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capability_level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "endpoint_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "adapter",
        "version",
        "capability_level",
        "endpoint_id"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "worker_model": {
          "type": "string",
          "minLength": 1
        },
        "judge_model": {
          "type": "string",
          "minLength": 1
        },
        "independent_judge": {
          "type": "boolean"
        }
      },
      "required": [
        "worker_model",
        "judge_model",
        "independent_judge"
      ],
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "mock": {
      "type": "boolean",
      "const": false
    },
    "sample_size": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "metrics": {
      "type": "object",
      "properties": {
        "success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "success_confidence_low": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "success_confidence_high": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "correct_stop_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cost_p50": {
          "type": "number",
          "minimum": 0
        },
        "cost_p95": {
          "type": "number",
          "minimum": 0
        },
        "duration_p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "duration_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "cost_currency": {
          "default": "USD",
          "type": "string",
          "const": "USD"
        }
      },
      "required": [
        "success_rate",
        "success_confidence_low",
        "success_confidence_high",
        "correct_stop_rate",
        "evidence_coverage",
        "cost_p50",
        "cost_p95",
        "duration_p50_ms",
        "duration_p95_ms",
        "cost_currency"
      ],
      "additionalProperties": false
    },
    "hard_gates": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "permission_violations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "safety_violations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "passed",
        "permission_violations",
        "safety_violations",
        "failures"
      ],
      "additionalProperties": false
    },
    "runs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "repetition": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "passed": {
            "type": "boolean"
          },
          "terminal": {
            "type": "string",
            "enum": [
              "completed",
              "blocked",
              "rejected",
              "failed"
            ]
          },
          "expected_terminal": {
            "type": "string",
            "enum": [
              "completed",
              "blocked",
              "rejected"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "evidence_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "permission_violations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "safety_violations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "cost_source": {
            "type": "string",
            "enum": [
              "runtime_estimate",
              "unknown"
            ]
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "artifact",
                    "source_url",
                    "runtime_terminal",
                    "stop_reason",
                    "runtime_cost",
                    "task_event"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "ref",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "checks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "criterion": {
                  "type": "string",
                  "minLength": 1
                },
                "passed": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "criterion",
                "passed",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "mock": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "receipt_id",
          "case_id",
          "repetition",
          "passed",
          "terminal",
          "expected_terminal",
          "score",
          "evidence_coverage",
          "permission_violations",
          "safety_violations",
          "cost",
          "cost_source",
          "duration_ms",
          "evidence",
          "checks",
          "mock"
        ],
        "additionalProperties": false
      }
    },
    "proof_pack_hash": {
      "type": "string",
      "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
    },
    "issuer": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "algorithm": {
              "type": "string",
              "const": "Ed25519"
            },
            "public_key": {
              "type": "string",
              "minLength": 1
            },
            "signature": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "key_id",
            "algorithm",
            "public_key",
            "signature"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "status_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract",
    "credential_id",
    "employee_id",
    "subject_hash",
    "memory_state_hash",
    "status",
    "profile",
    "runtime",
    "execution",
    "issued_at",
    "expires_at",
    "mock",
    "sample_size",
    "metrics",
    "hard_gates",
    "runs",
    "proof_pack_hash",
    "issuer",
    "status_reason"
  ],
  "additionalProperties": false
}
